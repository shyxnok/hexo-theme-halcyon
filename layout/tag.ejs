<div class="tag wrap">
  <h2 class="divider"><%= __('tag') %>: <%= page.tag %></h2>
  <% if (page.posts.length) { %>
    <div class="segments">
      <% page.posts.each(function(post) { %>
        <div class="item">
          <time datetime="<%= date(post.date, 'YYYY-MM-DDTHH:mm:ss') %>"><%= date(post.date, 'YYYY-MM-DD') %></time>
          <a href="<%- url_for(post.path) %>"><%= post.title %></a>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <p class="empty"><%= __('no_posts') %></p>
  <% } %>
</div>
