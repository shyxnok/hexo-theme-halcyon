<article class="post-full">
  <header class="post-header">
    <h1 class="post-title"><%= page.title %></h1>
    <div class="post-meta">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      <time datetime="<%= date(page.date, 'YYYY-MM-DDTHH:mm:ss') %>">
        <%= date(page.date, 'YYYY-MM-DD') %>
      </time>
      <% if (page.categories && page.categories.length) { %>
        <span class="meta-sep">·</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
        <% page.categories.each(function(cat) { %>
          <a class="category-link" href="<%- url_for(cat.path) %>"><%= cat.name %></a>
        <% }) %>
      <% } %>
      <% if (page.tags && page.tags.length) { %>
        <span class="meta-sep">·</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
        <% page.tags.each(function(tag) { %>
          <a class="tag-link" href="<%- url_for(tag.path) %>"><%= tag.name %></a>
        <% }) %>
      <% } %>
    </div>
  </header>

  <div class="post-content">
    <%- page.content %>
  </div>

  <% if (page.prev || page.next) { %>
  <nav class="post-nav">
    <% if (page.prev) { %>
      <a href="<%- url_for(page.prev.path) %>" class="post-nav-prev">
        <span class="nav-label">&larr; <%= __('newer') %></span>
        <span class="nav-title"><%= page.prev.title %></span>
      </a>
    <% } %>
    <% if (page.next) { %>
      <a href="<%- url_for(page.next.path) %>" class="post-nav-next">
        <span class="nav-label"><%= __('older') %> &rarr;</span>
        <span class="nav-title"><%= page.next.title %></span>
      </a>
    <% } %>
  </nav>
  <% } %>
</article>
