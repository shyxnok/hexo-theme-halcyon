<article class="post wrap" itemscope itemtype="http://schema.org/Article">
  <% if (page.cover) { %>
    <div class="cover">
      <img data-src="<%= page.cover %>" alt="<%= page.title %>">
    </div>
  <% } %>

  <div class="meta">
    <span class="item" title="<%= __('created') %>：<%= date(page.date, 'YYYY-MM-DD HH:mm:ss') %>">
      <span class="icon"><i class="halcyon i-calendar"></i></span>
      <time itemprop="dateCreated datePublished" datetime="<%= date(page.date, 'YYYY-MM-DDTHH:mm:ss') %>"><%= date(page.date, 'YYYY-MM-DD') %></time>
    </span>
    <% if (page.categories && page.categories.length) { %>
      <span class="item">
        <span class="icon"><i class="halcyon i-flag"></i></span>
        <% page.categories.each(function(cat) { %>
          <a href="<%- url_for(cat.path) %>" itemprop="articleSection"><%= cat.name %></a>
        <% }); %>
      </span>
    <% } %>
  </div>

  <h1 itemprop="name headline"><%= page.title %></h1>

  <div class="content md" itemprop="articleBody">
    <%- page.content %>
  </div>

  <% if (page.tags && page.tags.length) { %>
    <div class="tags">
      <% page.tags.each(function(tag) { %>
        <a href="<%- url_for(tag.path) %>"><i class="halcyon i-tag"></i><%= tag.name %></a>
      <% }); %>
    </div>
  <% } %>

  <% if (page.prev || page.next) { %>
    <nav class="near">
      <% if (page.prev) { %>
        <a href="<%- url_for(page.prev.path) %>" class="prev" title="<%= page.prev.title %>">
          <span class="label"><%= __('newer') %></span>
          <span class="title"><%= page.prev.title %></span>
        </a>
      <% } %>
      <% if (page.next) { %>
        <a href="<%- url_for(page.next.path) %>" class="next" title="<%= page.next.title %>">
          <span class="label"><%= __('older') %></span>
          <span class="title"><%= page.next.title %></span>
        </a>
      <% } %>
    </nav>
  <% } %>
</article>
