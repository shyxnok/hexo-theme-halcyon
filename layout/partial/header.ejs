<header class="site-header">
  <div class="header-inner">
    <a href="<%- url_for('/') %>" class="brand"><%= theme.site_brand || config.title %></a>

    <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation">
      <span class="hamburger"></span>
    </button>

    <nav class="site-nav" id="site-nav">
      <ul class="nav-menu">
        <% for (var name in theme.menu) { %>
          <% var url = theme.menu[name]; %>
          <li class="nav-item">
            <a href="<%- url_for(url) %>" class="nav-link"><%= name %></a>
          </li>
        <% } %>
      </ul>
    </nav>

    <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">
      <svg class="icon-sun" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <circle cx="8" cy="8" r="3"/>
        <line x1="8" y1="1" x2="8" y2="2.5"/>
        <line x1="8" y1="13.5" x2="8" y2="15"/>
        <line x1="1.5" y1="8" x2="3" y2="8"/>
        <line x1="13" y1="8" x2="14.5" y2="8"/>
        <line x1="3.4" y1="3.4" x2="4.5" y2="4.5"/>
        <line x1="11.5" y1="11.5" x2="12.6" y2="12.6"/>
        <line x1="3.4" y1="12.6" x2="4.5" y2="11.5"/>
        <line x1="11.5" y1="4.5" x2="12.6" y2="3.4"/>
      </svg>
      <svg class="icon-moon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M13.5 10.5a6 6 0 0 1-8-8 7 7 0 0 0 8 8Z"/>
      </svg>
    </button>
  </div>
    <%- partial('partial/wave') %>
</header>
