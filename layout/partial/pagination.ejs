<% if (page.total > 1) { %>
<nav class="pagination">
  <% if (page.prev) { %>
    <a href="<%- url_for(page.prev_link) %>" class="page-btn prev">&larr; <%= __('prev') %></a>
  <% } else { %>
    <span class="page-btn prev disabled">&larr; <%= __('prev') %></span>
  <% } %>
  <span class="page-info"><%= __('page', page.current) %> / <%= page.total %></span>
  <% if (page.next) { %>
    <a href="<%- url_for(page.next_link) %>" class="page-btn next"><%= __('next') %> &rarr;</a>
  <% } else { %>
    <span class="page-btn next disabled"><%= __('next') %> &rarr;</span>
  <% } %>
</nav>
<% } %>
