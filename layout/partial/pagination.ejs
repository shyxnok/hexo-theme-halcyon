<% if (page.total > 1) { %>
<nav class="pagination">
  <% if (page.prev) { %>
    <a href="<%- url_for(page.prev_link) %>" class="prev"><%= __('prev') %></a>
  <% } else { %>
    <span class="prev disabled"><%= __('prev') %></span>
  <% } %>
  <span class="info"><%= page.current %> / <%= page.total %></span>
  <% if (page.next) { %>
    <a href="<%- url_for(page.next_link) %>" class="next"><%= __('next') %></a>
  <% } else { %>
    <span class="next disabled"><%= __('next') %></span>
  <% } %>
</nav>
<% } %>
