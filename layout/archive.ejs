<div class="archive wrap">
  <h2 class="divider"><%= __('archives') %></h2>
  <div class="segments">
    <% var year = 0; %>
    <% page.posts.each(function(post) { %>
      <% var postYear = date(post.date, 'YYYY'); %>
      <% if (postYear !== year) { %>
        <% year = postYear; %>
        <h3 class="year"><%= year %></h3>
      <% } %>
      <div class="item">
        <time datetime="<%= date(post.date, 'YYYY-MM-DDTHH:mm:ss') %>"><%= date(post.date, 'MM-DD') %></time>
        <a href="<%- url_for(post.path) %>"><%= post.title %></a>
      </div>
    <% }); %>
  </div>
</div>
