<div class="archive-page">
  <h2 class="page-heading"><%= __('archives') %></h2>

  <% var year = 0; %>
  <% page.posts.each(function(post) { %>
    <% var postYear = date(post.date, 'YYYY'); %>
    <% if (postYear !== year) { %>
      <% year = postYear; %>
      <h3 class="archive-year"><%= year %></h3>
    <% } %>
    <div class="archive-item">
      <time class="archive-date" datetime="<%= date(post.date, 'YYYY-MM-DDTHH:mm:ss') %>">
        <%= date(post.date, 'MM-DD') %>
      </time>
      <a href="<%- url_for(post.path) %>" class="archive-title"><%= post.title %></a>
    </div>
  <% }) %>
</div>
