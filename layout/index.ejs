<div class="index wrap">
  <h2 class="divider"><%= __('recent_posts') %></h2>
  <div class="segments posts">
    <% page.posts.each(function(post) { %>
      <article class="item" itemscope itemtype="http://schema.org/Article">
        <% if (post.cover) { %>
          <div class="cover">
            <a href="<%- url_for(post.path) %>" itemprop="url" title="<%= post.title %>">
              <img data-src="<%= post.cover %>" alt="<%= post.title %>">
            </a>
          </div>
        <% } %>
        <div class="info">
          <div class="meta">
            <span class="item" title="<%= __('created') %>：<%= date(post.date, 'YYYY-MM-DD HH:mm:ss') %>">
              <span class="icon"><i class="halcyon i-calendar"></i></span>
              <time itemprop="dateCreated datePublished" datetime="<%= date(post.date, 'YYYY-MM-DDTHH:mm:ss') %>"><%= date(post.date, 'YYYY-MM-DD') %></time>
            </span>
          </div>
          <h3 itemprop="name headline">
            <a href="<%- url_for(post.path) %>" itemprop="url" title="<%= post.title %>"><%= post.title %></a>
          </h3>
          <div class="excerpt" itemprop="description">
            <%- post.excerpt || truncate(strip_html(post.content), {length: 200}) %>
          </div>
          <% if (post.categories && post.categories.length) { %>
            <div class="meta footer">
              <span>
                <% post.categories.each(function(cat) { %>
                  <a href="<%- url_for(cat.path) %>" itemprop="url" title="<%= cat.name %>"><i class="halcyon i-flag"></i><%= cat.name %></a>
                <% }); %>
              </span>
            </div>
          <% } %>
          <a href="<%- url_for(post.path) %>" itemprop="url" title="<%= post.title %>" class="btn"><%= __('read_more') %></a>
        </div>
      </article>
    <% }); %>
  </div>
  <%- partial('partial/pagination') %>
</div>
